---
import { Picture } from 'astro:assets'; import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { serviceImages } from '../data/portfolio';
const images = Object.entries(import.meta.glob<{default:ImageMetadata}>('../assets/services/*.{jpg,jpeg,png,webp}',{eager:true})); const image = (file:string) => images.find(([path])=>path.endsWith(file))?.[1].default;
---
<BaseLayout title="Palvelut – Studio Kurki" description="Henkilökuvaus, hääkuvaus, asuntokuvaus ja ajoneuvokuvaus. Jokainen kuvaus suunnitellaan kohteen ja tilanteen mukaan." path="/palvelut/"><SiteHeader/><main id="main" class="container"><header class="page-heading"><p class="eyebrow">Studio Kurki · Lahti</p><h1>Palvelut</h1><p class="lead">Kuvaan hetkiä, jotka merkitsevät. Ajoneuvoista ja kodeista ihmisiin – jokainen kuvaus suunnitellaan huolella, jotta tarinasi välittyy aidosti ja vaikuttavasti.</p></header>
<section class="service-feature" id="henkilokuvaus"><div><p class="eyebrow">01 · Henkilökuvaus</p><h2>Teidän näköisiä muistoja.</h2><p>Rento kuvaushetki, jossa tärkeintä ei ole täydellinen poseeraus vaan aito yhteys, liike ja yhdessäolo.</p><p>Luonnollisia kuvia, joissa elämä saa näkyä. Valitse teille ajankohtainen kuvaus. Jokainen kokonaisuus suunnitellaan ihmisten, paikan ja tunnelman mukaan.</p><h3>Lapsi- ja perhekuvaus</h3><p>Kuvauksessa saa liikkua, nauraa, pitää sylissä ja olla lähellä. Ohjaan lempeästi, jotta kuvista tulee teidän näköisiänne – ei jäykkiä tai liian aseteltuja.</p><p>Rento, noin tunnin kuvaushetki toivomassanne miljöössä tai studiossa.</p><p><strong>Kuvaukseen sisältyy</strong></p><ul><li>Perhe- ja lapsikuvaukset</li><li>Kuvaus miljöössä, kotona tai studiossa</li><li>Valmistautumisohjeet ennen kuvausta</li><li>Sähköinen esikatselugalleria</li><li>Valitsemanne viimeistellyt kuvat</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><h3>Valmistujais- ja muotokuvaus</h3><p>Ajattomat valmistujais- ja muotokuvat tehdään rauhassa, ilman suorituspaineita. Lopputulos on huoliteltu mutta edelleen sinun näköisesi.</p><p>Rento, noin tunnin kuvaushetki toivomassanne miljöössä. Kuvauksen aikana tehdään sekä ajattomia potretteja että luonnollisia kuvia, joissa persoona saa näkyä.</p><p><strong>Kuvaukseen sisältyy</strong></p><ul><li>Kuvaus valitsemassanne miljöössä tai juhlapäivänä</li><li>Valmistujaispotretit, muotokuvat ja lähikuvat</li><li>Sähköinen esikatselugalleria</li><li>Valitsemanne viimeistellyt kuvat</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><a class="text-cta" href="/hinnasto/#lapsi-ja-perhekuvaus">Katso hinnat: lapsi- ja perhekuvaus</a> · <a class="text-cta" href="/hinnasto/#valmistujais-ja-muotokuvaus">Katso hinnat: valmistujais- ja muotokuvaus</a> · <a href="/yhteystiedot/">Varaa aika</a></div><div class="service-images"><Picture src={image(serviceImages.perhe.file)!} alt={serviceImages.perhe.alt} widths={[500,800]} sizes="(max-width:700px) 100vw, 40vw" formats={['avif','webp']} loading="lazy" decoding="async"/><Picture src={image(serviceImages.muotokuva.file)!} alt={serviceImages.muotokuva.alt} widths={[500,800]} sizes="(max-width:700px) 100vw, 40vw" formats={['avif','webp']} loading="lazy" decoding="async"/></div></section>
<section class="service-feature" id="haakuvaus"><div><p class="eyebrow">02 · Hääkuvaus</p><h2>Pienistä katseista suuriin juhliin</h2><p>Hääkuvissa tärkeät ihmiset, tunnelma ja päivän pienet yksityiskohdat saavat elää. Valitse potretit tai kokonaisuus vihkimisestä juhlaan.</p><h3>Kihlapotretit</h3><p>Rento, noin tunnin kuvaushetki valitsemassanne miljöössä. Ennen kuvausta suunnittelemme yhdessä kuvauspaikan, tunnelman ja juuri teille sopivan kokonaisuuden.</p><p><strong>Kuvaukseen sisältyy</strong></p><ul><li>Suunnittelupalaveri kasvotusten tai puhelimitse</li><li>Noin tunnin kuvaus valitsemassanne miljöössä</li><li>10 viimeisteltyä kuvaa digitaalisena</li><li>Sähköinen esikatselugalleria</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><p>Varaa kuvausaika ja suunnitellaan yhdessä teidän näköisenne kihlapotretit.</p><h3>Hääpotretit</h3><p>Rauhallinen 1–2 tunnin kuvaushetki valitsemassanne miljöössä. Ennen kuvausta suunnittelemme yhdessä kuvauspaikan, tunnelman ja juuri teille sopivan kokonaisuuden.</p><p><strong>Kuvaukseen sisältyy</strong></p><ul><li>Suunnittelupalaveri kasvotusten tai puhelimitse</li><li>1–2 tunnin kuvaus valitsemassanne miljöössä</li><li>Sähköinen esikatselugalleria</li><li>Valitsemanne viimeistellyt kuvat</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><p>Varaa kuvausaika ja suunnitellaan yhdessä teidän näköisenne hääpotretit.</p><h3>Vihkiminen &amp; juhlat</h3><p>Hääpäivän dokumentaarinen kuvaus sisältää hääpotretit, vihkimisen sekä juhlien tärkeät hetket valitsemanne kuvausajan mukaan. Ennen hääpäivää pidämme suunnittelupalaverin, jossa käymme yhdessä läpi päivän aikataulun, kuvauspaikat ja teille tärkeimmät hetket.</p><p><strong>Kuvaukseen sisältyy</strong></p><ul><li>Suunnittelupalaveri kasvotusten tai puhelimitse</li><li>Hääpotretit</li><li>Vihkimisen dokumentaarinen kuvaus</li><li>Juhlien tärkeiden hetkien kuvaus</li><li>Viimeistellyt kuvat digitaalisena</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><p>Kertokaa minulle hääpäivästänne, niin suunnitellaan yhdessä juuri teille sopiva kuvauskokonaisuus.</p><a href="/hinnasto/#haat">Katso hinnat</a> · <a href="/yhteystiedot/">Varaa aika</a></div><Picture class="service-photo" src={image(serviceImages.haat.file)!} alt={serviceImages.haat.alt} widths={[600,900]} sizes="(max-width:700px) 100vw, 42vw" formats={['avif','webp']} loading="lazy" decoding="async"/></section>
<section class="service-feature" id="asuntokuvaus"><div><p class="eyebrow">03 · Asuntokuvaus</p><h2>Luonnollinen valo, harkitut kuvakulmat</h2><p>Luonnolliset ja kutsuvat kuvat näyttävät kodin parhaat puolet, mittasuhteet ja yksityiskohdat juuri sellaisina kuin ne tuntuvat.</p><div class="steps"><article><h3>01 Suunnittelu</h3><p>Käymme läpi kohteen, kuvien käyttötarkoituksen ja toivotun tunnelman. Saat myös selkeät valmisteluohjeet ennen kuvausta.</p></article><article><h3>02 Kuvaus</h3><p>Kuvaan tilat luonnollisessa valossa niin, että kokonaisuus, mittasuhteet ja kodin kiinnostavimmat yksityiskohdat erottuvat. Dronekuvat sovittaessa.</p><ul><li>Laajat tila- ja yksityiskohtakuvat</li><li>Dronekuvat sovittaessa</li></ul></article><article><h3>03 Viimeistely</h3><p>Jokainen kuva viimeistellään huolellisesti luonnollista ilmettä vaalien ja toimitetaan käyttövalmiina suojatun Google Drive -linkin kautta.</p><ul><li>Suoristus ja luonnollinen värinkäsittely</li><li>Korkearesoluutioiset valmiit kuvat</li></ul></article></div><h3>Kaunista, mutta totta.</h3><p>Hyvä asuntokuva ei muuta kotia toiseksi. Se auttaa näkemään tilan valon, luonteen ja mahdollisuudet parhaimmillaan.</p><a href="/hinnasto/#asuntokuvaus">Katso hinnat</a> · <a href="/yhteystiedot/">Ota yhteyttä</a></div><Picture class="service-photo" src={image(serviceImages.asunto.file)!} alt={serviceImages.asunto.alt} widths={[600,900]} sizes="(max-width:700px) 100vw, 42vw" formats={['avif','webp']} loading="lazy" decoding="async"/></section>
<section class="service-feature service-feature-text" id="ajoneuvokuvaus"><div><p class="eyebrow">04 · Ajoneuvokuvaus</p><h2>Kuvat, jotka tekevät vaikutuksen.</h2><p>Ajoneuvosi ansaitsee kuvat, jotka erottuvat ja herättävät kiinnostuksen.</p><p>Korostan muotoilua, yksityiskohtia ja tunnelmaa. Olipa kyseessä auto, moottoripyörä tai vene, luon kuvia, jotka erottuvat ja jäävät mieleen.</p></div><div class="service-panel"><h3>Valokuvat ja videokuvaus</h3><p>Ajoneuvosta kuvataan näyttävät kokonaiskuvat, sisätila ja tärkeät yksityiskohdat. Tunnelmallinen myyntivideo tuo esiin ajoneuvon linjat, yksityiskohdat ja liikkeen.</p><ul><li>Ulko-, sisä- ja yksityiskohtakuvat</li><li>Kuvaus valitussa miljöössä</li><li>Huolellinen kuvankäsittely</li><li>Valmiit korkearesoluutioiset kuvat</li><li>Videon suunnittelu ja kuvaus</li><li>Leikkaus ja värien viimeistely</li><li>Valmis video verkkosivuille ja sosiaaliseen mediaan</li><li>Toimitus suojatun Google Drive -linkin kautta</li></ul><a href="/hinnasto/#ajoneuvokuvaus">Katso hinnat</a> · <a href="/yhteystiedot/">Ota yhteyttä</a></div></section>
<section class="service-feature" id="maisemat"><div><p class="eyebrow">05 · Maisemat</p><h2>Luonto ja maisema</h2><p>Kaikki lähti luonnosta ja maisemasta – ne olivat kuvauskohteeni, kun sain ensimmäisen kamerani nuorena. Portfoliossa pääset näkemään omia maisemakuviani ja sitä, mitä silmäni näkevät. Luonnossa omat akkuni latautuvat, kaukana melusta: syvä hiljaisuus ja paljon ihmeteltävää.</p><a href="/#portfolio">Katso kuvia</a></div></section>
<section class="section"><div class="container"><p class="eyebrow">Yhteinen suunnitelma</p><h2>Näin kuvaus etenee</h2><div class="steps"><article><h3>01 Tutustutaan</h3><p>Käymme läpi toiveet, kuvauspaikan ja tärkeät ihmiset.</p></article><article><h3>02 Kuvataan</h3><p>Saat selkeää ja lempeää ohjausta koko kuvaushetken ajan.</p></article><article><h3>03 Muistetaan</h3><p>Viimeistellyt kuvat toimitetaan suojatun Google Drive -linkin kautta.</p></article></div></div></section></main><SiteFooter/><script>import '../scripts/webmcp';</script></BaseLayout>
