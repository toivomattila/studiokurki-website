---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { business } from '../data/business';
---
<BaseLayout title="Valokuvauspalvelut – Studio Kurki, Lahti" description="Tutustu Studio Kurjen valokuvauspalveluihin. Maisemakuvaus on Arnon Kurjen pääala. Saat myös kuvankäsittelyä ja valokuvauksen opastusta." path="/palvelut/">
  <SiteHeader />
  <main id="main" class="container">
    <header class="page-heading"><p class="eyebrow">Studio Kurki · Lahti</p><h1>Valokuvauspalvelut</h1><p class="lead">Maisemakuvaus on pääalani. Autan myös muissa kuvauksissa, olemassa olevien kuvien käsittelyssä ja valokuvauksen oppimisessa.</p></header>
    <ul class="service-list">{business.services.map((service) => <li><h2>{service.name}</h2><p>{service.description}</p></li>)}</ul>
    <p class="prose">Kysy tarjous: <a href="mailto:arnon@studiokurki.com">arnon@studiokurki.com</a>.</p>
    <section class="section about-teaser" id="arnon"><div><p class="eyebrow">Valokuvaaja</p><h2>Arnon Kurki</h2></div><div class="prose"><p>Olen Arnon Kurki, valokuvaaja Lahdesta. Olen erikoistunut erityisesti maisemakuvaukseen. Luonto, valot ja tunnelmat ovat sydäntäni lähellä. Aloin syventyä valokuvauksen taitoihin vuonna 2021, kun suoritin vuoden pituisen valokuvauskurssin Vapaassa Akatemiassa. Kurssin jälkeen jatkoin aktiivisesti kuvaamista harrastajana, kehitin taitojani ja laajensin osaamistani. Maisemien lisäksi autan mielelläni myös muilla valokuvauksen osa-alueilla tarpeen mukaan. Tarjoan myös valokuvauksen opastusta. Palvelen suomeksi ja englanniksi, ja osaamiseeni kuuluu Adobe Lightroom.</p></div></section>
  </main>
  <SiteFooter />
  <script>import '../scripts/webmcp';</script>
</BaseLayout>
