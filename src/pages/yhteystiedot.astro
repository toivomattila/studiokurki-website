---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { business } from '../data/business';
---
<BaseLayout title="Yhteystiedot – Studio Kurki" description="Kerro lyhyesti, mitä haluaisit kuvata, niin palaan asiaan mahdollisimman pian." path="/yhteystiedot/"><SiteHeader/><main id="main" class="container"><header class="page-heading"><p class="eyebrow">Studio Kurki · Lahti</p><h1>Ota yhteyttä</h1><p class="lead">Kerro lyhyesti, mitä haluaisit kuvata, niin palaan asiaan mahdollisimman pian.</p></header><section class="contact-layout" aria-label="Yhteystiedot"><div><p class="eyebrow">Sähköposti</p><a class="email-link" href={`mailto:${business.email}`}>{business.email}</a></div><div class="contact-details"><p><strong>Instagram</strong><br/><a href={business.instagram} rel="me noopener">@studiokurki</a></p><p><strong>Facebook</strong><br/><a href={business.facebook} rel="me noopener">Facebook: Studio Kurki</a></p><p><strong>Paikkakunta</strong><br/>Lahti</p><p><strong>Y-tunnus</strong><br/>2960962-9</p></div></section></main><SiteFooter/><script>import '../scripts/webmcp';</script></BaseLayout>
