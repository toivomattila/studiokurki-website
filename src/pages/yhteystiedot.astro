---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { business } from '../data/business';
---
<BaseLayout title="Yhteystiedot – Studio Kurki, Lahti" description="Ota yhteyttä valokuvaaja Arnon Kurkeen. Kerro kuvauksen aihe, ajankohta ja paikka. Sähköposti: arnon@studiokurki.com." path="/yhteystiedot/">
  <SiteHeader />
  <main id="main" class="container">
    <header class="page-heading"><p class="eyebrow">Studio Kurki · Lahti</p><h1>Ota yhteyttä</h1><p class="lead">Mielessä kuvaus, kuvien käsittely tai valokuvauksen opastus? Kirjoita sähköpostia.</p></header>
    <section class="contact-layout" aria-label="Yhteystiedot">
      <div><p class="eyebrow">Sähköposti</p><a class="email-link" href={`mailto:${business.email}`}>{business.email}</a></div>
      <div class="contact-details"><p><strong>Paikkakunta</strong><br />Lahti</p><p><strong>Y-tunnus</strong><br />2960962-9</p><p>Kerro viestissä kuvauksen aihe, ajankohta ja paikka.</p></div>
    </section>
  </main>
  <SiteFooter />
  <script>import '../scripts/webmcp';</script>
</BaseLayout>
