---
import { Picture } from 'astro:assets'; import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { aboutImage } from '../data/portfolio';
const photo = Object.entries(import.meta.glob<{default:ImageMetadata}>('../assets/about/*.{jpg,jpeg,png,webp}',{eager:true})).find(([path])=>path.endsWith(aboutImage.file))?.[1].default;
---
<BaseLayout title="Valokuvaaja Arnon Kurki – Studio Kurki" description="Olen Arnon Kurki, Studio Kurjen valokuvaaja. Kuvaan ihmisiä ja hetkiä rauhallisella, luonnollisella ja hieman elokuvallisella otteella." path="/valokuvaaja/"><SiteHeader/><main id="main" class="container"><header class="page-heading"><p class="eyebrow">Valokuvaaja</p><h1>Heih, olen Arnon.</h1></header><section class="bio-intro"><div class="prose"><p>Olen Studio Kurjen valokuvaaja. Kuvaan ihmisiä ja hetkiä rauhallisella, luonnollisella ja hieman elokuvallisella otteella.</p><p>Minua kiinnostavat aidot ilmeet, muuttuva valo ja pienet yksityiskohdat, jotka tekevät kuvasta henkilökohtaisen.</p></div>{photo && <Picture class="bio-photo" src={photo} alt={aboutImage.alt} widths={[500,800,1100]} sizes="(max-width:700px) 100vw, 42vw" formats={['avif','webp']} loading="lazy" decoding="async"/>}</section><section class="section"><h2>Kaikki alkoi lainakamerasta</h2><ol class="timeline"><li><span>2012</span><div><h3>Ensimmäinen järjestelmäkamera</h3><p>Kiinnostukseni valokuvaukseen alkoi vuoden 2012 tienoilla, kun isäni osti itselleen järjestelmäkameran. Hän ei lopulta innostunut kameran asetusten opettelemisesta, joten sain sen lainaksi omaan käyttööni.</p></div></li><li><span>Sen jälkeen</span><div><h3>Opettelua ja ensimmäiset kuvauskohteet</h3><p>Aloin opetella valokuvauksen teoriaa itsenäisesti YouTuben avulla ja otin kameran mukaani pikkusiskoni treeneihin, peleihin ja leireille. Kuvasin aluksi omaksi ilokseni, mutta samalla halusin jatkuvasti oppia lisää.</p></div></li><li><span>2021</span><div><h3>Valokuvakoulutus ja yrittäjyys</h3><p>Vuosien myötä kiinnostukseni valokuvaukseen kasvoi yhä vahvemmaksi. Vuonna 2021 aloitin vuoden mittaisen valokuvauskoulutuksen Lahden Vapaa-Akatemiassa. Koulutuksen jälkeen ryhdyin lähes saman tien yrittäjäksi – ja sillä tiellä olen edelleen.</p></div></li></ol></section><section class="section about-teaser"><div><p class="eyebrow">Miksi kuvaan</p><h2 class="display-quote">Kuvaan, jotta hetki säilyy.</h2></div><div class="prose"><p>Valokuvaus on minulle tapa näyttää muille, miten näen ja koen ympärilläni olevan maailman.</p><p>Kameran kautta pystyn tuomaan esille ajatuksiani, persoonaani ja asioita, joita en välttämättä osaisi ilmaista muuten.</p><p>Yhtä tärkeää minulle on mahdollisuus tallentaa ihmisille hetkiä, joihin he voivat palata vielä vuosienkin kuluttua. Kuvauskohdetta tärkeämpää on se, että kuvalla ja hetkellä on merkitystä kuvattavalle ihmiselle.</p></div></section><section class="section"><div class="container"><p class="eyebrow">Kuvaustilanne</p><h2>Rento. Läsnä. Luonnollinen.</h2><div class="prose"><p>Kuvaajana olen rento, sosiaalinen ja helposti lähestyttävä. Kameran edessä ei tarvitse esittää mitään tai miettiä, miltä pitäisi näyttää. Ilo, nauru, herkistyminen ja kaikki muutkin tunteet saavat näkyä.</p><p>Jos kuvaaminen jännittää, olen tilanteessa aidosti läsnä, juttelen kanssasi ja autan omaa persoonaasi tulemaan esille luonnollisesti.</p><p>Kuvissani tavoittelen aitoa ja tunnelmallista lopputulosta. Työskentelen mielelläni luonnonvalossa ja kuvaan mahdollisuuksien mukaan ulkona – säällä kuin säällä. Käsittelen kuvat huolellisesti mutta maltillisesti, jotta niiden luonnollisuus, tunnelma ja hetkessä syntyneet tunteet säilyvät.</p></div></div></section><section class="contact-band"><div><h2>Tutustutaanko?</h2><p>Ota rohkeasti yhteyttä, niin suunnitellaan yhdessä juuri sinulle sopiva kuvaus ja muistot, joihin haluat palata vielä vuosien päästä.</p></div><a class="button-link" href="/yhteystiedot/">Ota yhteyttä</a></section></main><SiteFooter/><script>import '../scripts/webmcp';</script></BaseLayout>
