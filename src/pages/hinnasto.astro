---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { priceGroups, priceNotes, formatPrice } from '../data/prices';
---
<BaseLayout title="Hinnasto – Studio Kurki" description="Tutustu kuvausvaihtoehtoihin ja valitse sopiva paketti. Suunnitellaan yhdessä juuri sinulle sopiva kuvaus." path="/hinnasto/"><SiteHeader/><main id="main" class="container"><header class="page-heading"><p class="eyebrow">Studio Kurki · Lahti</p><h1>Hinnasto</h1><p class="lead">Valitse sinulle sopiva paketti ja suunnitellaan yhdessä juuri sinun näköisesi kuvaushetki.</p></header>{priceGroups.map(group=><section class="price-group" id={group.id}><h2>{group.title}</h2><div class="price-cards">{group.packages.map(pkg=><article class="price-card"><div class="price-title"><h3>{pkg.name}</h3><p>{formatPrice(pkg.price)}</p></div><ul>{pkg.details.map(detail=><li>{detail}</li>)}</ul></article>)}</div></section>)}<section class="price-notes"><h2>Huomioitavaa</h2><ul>{priceNotes.map(note=><li>{note}</li>)}</ul></section><section class="contact-band price-cta"><div><p>Valitse sopiva paketti ja varaa kuvausaika. Suunnitellaan yhdessä juuri sinun näköisesi kuvaushetki.</p></div><a class="button-link" href="/yhteystiedot/">Varaa aika</a></section></main><SiteFooter/><script>import '../scripts/webmcp';</script></BaseLayout>
